{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Html九尾狐",
  "version": "0.9.0-alpha.0",
  "identifier": "com.kratoslee.htmlninefox",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Html九尾狐 · 本地优先的 HTML 工作台",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
